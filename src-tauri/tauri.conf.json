{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "边栏待办",
  "version": "0.6.0",
  "identifier": "com.haovu.sidebartodo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "边栏待办",
        "width": 60,
        "height": 340,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "贴在屏幕边上的待办和便签",
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "sidebar-todo",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEMkY2RUVGOTMwN0FCRTgKUldUb3F3ZVQ3MjR2cmEvaGUzZEgzWkFDK3VFTVFXLzdqaUZ1QlE0SUVla2lSTHJyZmNZWklMM0oK",
      "endpoints": [
        "https://github.com/qixiaochen653/sidebar-todo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
